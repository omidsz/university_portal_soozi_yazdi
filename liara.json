{
  "app": "soozi-yazdi",
  "build": {
    "location": "iran"
  },
  "processes": {
    "web": "gunicorn university_portal.wsgi:application --bind 0.0.0.0:$PORT",
    "worker": "celery -A university_portal worker --loglevel=info"
  },
  "disks": [
    {
      "name": "disk",
      "mountTo": "/app/staticfiles"
    },
    {
      "name": "databasedisk",
      "mountTo": "data/"
    }
  ]

}